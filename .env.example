# Local dev: SKIP_AUTH=true skips middleware (no password needed). Unset or false + DOCS_AUTH_ENABLED forces gate locally.
SKIP_AUTH=true

# Gate the site (must be exactly "true" for production; case-insensitive in middleware)
DOCS_AUTH_ENABLED=false

# Shared site password (Credentials provider). Required when DOCS_AUTH_ENABLED=true and not using Google-only.
DOCS_SITE_PASSWORD=

# NextAuth signing secret (required when auth is on). Generate: openssl rand -base64 32
AUTH_SECRET=

# Canonical public URL of this deployment (no trailing slash). Vercel: https://your-project.vercel.app
AUTH_URL=http://localhost:3000

# Trust the Host header (required on Vercel for Auth.js / NextAuth)
AUTH_TRUST_HOST=true

# Google OAuth (optional; if both set, Google appears on sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DOCS_AUTH_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase API Documentation (optional)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_EDGE_OPENAPI_URL=
