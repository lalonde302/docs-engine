# Local dev convenience:
# - SKIP_AUTH=true  => bypass auth entirely (no Google creds needed)
# - SKIP_AUTH=false => force auth on locally (requires Google creds)
# If unset, auth is skipped in development and enforced otherwise.
SKIP_AUTH=true

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Set the base URL for auth callbacks
AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Supabase API Documentation
# ─────────────────────────────────────────────────────────────────────────────
# These env vars enable live API documentation that updates automatically
# when your Supabase schema or Edge Functions change.

# Supabase project URL and anon key (for REST API spec)
# The docs site fetches the auto-generated PostgREST OpenAPI spec from:
#   ${SUPABASE_URL}/rest/v1/?apikey=${SUPABASE_ANON_KEY}
SUPABASE_URL=https://soiskefdgeewxwpjctfd.supabase.co
SUPABASE_ANON_KEY=

# Supabase Edge Functions OpenAPI URL
# This is the URL of the deployed openapi Edge Function that serves the
# OpenAPI spec for all Edge Functions. The docs site proxies this spec
# so that Scalar can render it.
# Example: https://soiskefdgeewxwpjctfd.supabase.co/functions/v1/openapi
SUPABASE_EDGE_OPENAPI_URL=
